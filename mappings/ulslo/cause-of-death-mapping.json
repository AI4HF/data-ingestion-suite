{
  "id": "cause-of-death-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/ulslo/cause-of-death-mapping",
  "name": "cause-of-death-mapping",
  "title": "Mapping of OMOP death to the DT4H-CauseOfDeath profile",
  "isDraft": false,
  "source": [
    {
      "alias": "omopDeath",
      "url": "https://ai4hf.eu/fhir/schemas/ulslo/OMOP-Death",
      "joinOn": []
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "causeExists",
      "language": "text/fhirpath",
      "expression": "(cause_concept_id.exists() and cause_concept_id != 0) or (cause_source_concept_id.exists() and cause_source_concept_id != 0)"
    }
  ],
  "mapping": [
    {
      "precondition": {
        "name": "deathDateExists",
        "language": "text/fhirpath",
        "expression": "death_date.exists() or death_datetime.exists()"
      },
      "expression": {
        "name": "result",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', 'Death' & person_id.toString())}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-CauseOfDeath"
            ]
          },
          "resourceType": "Observation",
          "status": "final",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "exam",
                  "display": "Exam"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "79378-6",
                "display": "Cause of death",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{iif(death_datetime.empty(), death_date, death_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'))}}",
          "valueCodeableConcept": {
            "coding": "{{* iif(%causeExists.not(), utl:createFhirCoding('http://hl7.org/fhir/sid/icd-10', 'R99', 'Other ill-defined and unspecified causes of mortality'), iif(cause_concept_id.exists() and cause_concept_id != 0,trms:translateToCoding(cause_concept_id.toString(), 'https://www.ohdsi.org/omop', 'https://ai4hf.eu/fhir/mappings/ConceptMap/omop-to-icd10'),iif(cause_source_concept_id.exists() and cause_source_concept_id != 0, trms:translateToCoding(cause_source_concept_id.toString(), 'https://www.ohdsi.org/omop', 'https://ai4hf.eu/fhir/mappings/ConceptMap/omop-to-icd10'), {})))}}"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', person_id.toString())}}"
        }
      }
    }
  ]
}