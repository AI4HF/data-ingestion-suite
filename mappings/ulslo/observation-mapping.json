{
  "id": "observation-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/ulslo/observation-mapping",
  "name": "observation-mapping",
  "title": "Mapping of OMOP observation to several DT4H profiles",
  "isDraft": false,
  "source": [
    {
      "alias": "observation",
      "url": "https://ai4hf.eu/fhir/schemas/ulslo/OMOP-Observation",
      "joinOn": [
        "visit_occurrence_id"
      ]
    },
    {
      "alias": "omopVisit",
      "url": "https://ai4hf.eu/fhir/schemas/ulslo/OMOP-VisitOccurrence",
      "joinOn": [
        "visit_occurrence_id"
      ]
    }
  ],
  "context": {
    "smokingStatusConceptMap": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/ulslo/smoking-status.csv"
    },
    "nyhaConceptMap": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/ulslo/nyha-concept-map.csv"
    }
  },
  "variable": [],
  "mapping": [
    {
      "description": "Mapping of OMOP observation to the DT4H smoking status profile",
      "precondition": {
        "name": "isSmokingStatus",
        "language": "text/fhirpath",
        "expression": "observation_concept_id = 43054909 and mpp:getConcept(%smokingStatusConceptMap, iif(value_source_value.exists(), value_source_value, observation_source_value)).exists()"
      },
      "expression": {
        "name": "smoking",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', observation_id)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-SmokingStatus"
            ]
          },
          "resourceType": "Observation",
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', person_id.toString())}}",
          "encounter": "{{? iif(visit_occurrence_id.exists(), mpp:createFhirReferenceWithHashedId('Encounter', visit_occurrence_id), %omopVisit.select(iif($this.visit_start_date <= %context.observation_date and $this.visit_end_date >= %context.observation_date,mpp:createFhirReferenceWithHashedId('Encounter', $this.visit_occurrence_id),{})).first())}}",
          "effectivePeriod": {
            "start": "{{iif(observation_datetime.exists(),observation_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'),observation_date)}}"
          },
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "social-history",
                  "display": "Social History"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "72166-2",
                "display": "Tobacco smoking status",
                "@sliceName": "loincCode"
              }
            ]
          },
          "valueCodeableConcept": {
            "{{#concept}}": "{{mpp:getConcept(%smokingStatusConceptMap, iif(value_source_value.exists(), value_source_value, observation_source_value))}}",
            "{{?}}": "{{utl:createFhirCodeableConcept(%concept.target_system, %concept.target_code, %concept.target_display)}}"
          },
          "status": "final"
        }
      }
    },
    {
      "description": "Mapping of OMOP observation to the DT4H NYHA profile",
      "precondition": {
        "name": "isNYHA",
        "language": "text/fhirpath",
        "expression": "observation_concept_id = 36305765 and mpp:getConcept(%nyhaConceptMap, iif(value_source_value.exists(), value_source_value, observation_source_value)).exists()"
      },
      "expression": {
        "name": "nyha",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', observation_id)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-NYHAAssessment"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "exam",
                  "display": "Exam"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "88020-3",
                "display": "Functional capacity NYHA",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{iif(observation_datetime.exists(),observation_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'),observation_date)}}",
          "valueCodeableConcept": {
            "{{#concept}}": "{{mpp:getConcept(%nyhaConceptMap, iif(value_source_value.exists(), value_source_value, observation_source_value))}}",
            "{{?}}": "{{utl:createFhirCodeableConcept(%concept.target_system, %concept.target_code, %concept.target_display)}}"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', person_id.toString())}}",
          "encounter": "{{? iif(visit_occurrence_id.exists(), mpp:createFhirReferenceWithHashedId('Encounter', visit_occurrence_id), %omopVisit.select(iif($this.visit_start_date <= %context.observation_date and $this.visit_end_date >= %context.observation_date,mpp:createFhirReferenceWithHashedId('Encounter', $this.visit_occurrence_id),{})).first())}}",
          "status": "final"
        }
      }
    }
  ]
}