{
  "id": "medication-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/ulslo/medication-mapping",
  "name": "medication-mapping",
  "title": "Mapping of OMOP drug exposure (EHR prescriptions) to the DT4H medication request profile",
  "isDraft": false,
  "source": [
    {
      "alias": "omopDrugExposure",
      "url": "https://ai4hf.eu/fhir/schemas/ulslo/OMOP-DrugExposure",
      "joinOn": []
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "atcCodings",
      "language": "text/fhirpath",
      "expression": "trms:translateToCoding(drug_concept_id.toString(), 'https://www.ohdsi.org/omop', 'https://ai4hf.eu/fhir/mappings/ConceptMap/omop-to-atc')"
    }
  ],
  "mapping": [
    {
      "description": "ULSLO drug exposures are all of type 32838 (EHR prescription), so they are mapped to MedicationRequest.",
      "precondition": {
        "name": "isEhrPrescription",
        "language": "text/fhirpath",
        "expression": "drug_type_concept_id = 32838"
      },
      "expression": {
        "name": "result",
        "language": "application/fhir-template+json",
        "value": {
          "{{#atc}}": "{{%atcCodings}}",
          "{{*}}": {
            "id": "{{mpp:getHashedId('MedicationRequest', drug_exposure_id & '_' & %atc.code)}}",
            "meta": {
              "profile": [
                "https://datatools4heart.eu/fhir/StructureDefinition/HFR-MedicationRequest"
              ]
            },
            "resourceType": "MedicationRequest",
            "status": "unknown",
            "intent": "order",
            "medication": {
              "concept": "{{utl:createFhirCodeableConcept('http://www.whocc.no/atc', %atc.code, %atc.display)}}"
            },
            "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', person_id.toString())}}",
            "encounter": "{{? iif(visit_occurrence_id.exists(), mpp:createFhirReferenceWithHashedId('Encounter', visit_occurrence_id), {})}}",
            "authoredOn": "{{iif(drug_exposure_start_datetime.exists(), drug_exposure_start_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'), drug_exposure_start_date)}}",
            "effectiveDosePeriod": {
              "start": "{{iif(drug_exposure_start_datetime.exists(), drug_exposure_start_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'), drug_exposure_start_date)}}",
              "end": "{{? iif(drug_exposure_end_datetime.exists(), drug_exposure_end_datetime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss.SSS' | 'yyyy-MM-dd HH:mm:ss'), drug_exposure_end_date)}}"
            },
            "dosageInstruction": [
              {
                "text": "{{? sig}}",
                "doseAndRate": [
                  {
                    "doseQuantity": {
                      "{{#dose}}": "{{iif(quantity.exists() and quantity > 0, quantity, {})}}",
                      "{{?}}": {
                        "value": "{{%dose}}",
                        "unit": "{{? dose_unit_source_value}}"
                      }
                    }
                  }
                ]
              }
            ],
            "dispenseRequest": {
              "numberOfRepeatsAllowed": "{{? iif(refills.exists() and refills >= 0, refills, {})}}",
              "expectedSupplyDuration": {
                "{{#ds}}": "{{iif(days_supply.exists() and days_supply > 0, days_supply, {})}}",
                "{{?}}": {
                  "value": "{{%ds}}",
                  "unit": "days",
                  "system": "http://unitsofmeasure.org",
                  "code": "d"
                }
              }
            }
          }
        }
      }
    }
  ]
}
