{
  "id": "nyha-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/nyha-mapping",
  "name": "nyha-mapping",
  "title": "NYHA Mapping",
  "isDraft": false,
  "source": [
    {
      "alias": "medication",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/NYHA",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {
    "nyhaClassificationConceptMap": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/citbm/nyha-classification.csv"
    }
  },
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "New York Heart Association classification if exists.",
      "expression": {
        "name": "nyha",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', identifier & effectiveDateTime)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-NYHAAssessment"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "exam",
                  "display": "Exam"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "88020-3",
                "display": "Functional capacity NYHA",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd')}}",
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "{{mpp:getConcept(%nyhaClassificationConceptMap, nyha_class, 'target_code')}}",
                "display": "{{mpp:getConcept(%nyhaClassificationConceptMap, nyha_class, 'target_display')}}"
              }
            ]
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    }
  ]
}