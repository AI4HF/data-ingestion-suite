{
  "id": "condition-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/condition-mapping",
  "name": "condition-mapping",
  "title": "Condition Mapping",
  "isDraft": false,
  "source": [
    {
      "alias": "medication",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Condition",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.onsetDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'dd/MM/yyyy' | 'yyyy-MM-dd').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.onsetDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'dd/MM/yyyy' | 'yyyy-MM-dd').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "The patient's diagnosis.",
      "expression": {
        "name": "diagnosis",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Condition',subject & encounter.lower() & code & onsetDateTime)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Condition"
            ]
          },
          "resourceType": "Condition",
          "code": {
            "coding": [
              {
                "code": "{{code}}",
                "system": "http://hl7.org/fhir/sid/icd-10",
                "@sliceName": "icd10Code"
              }
            ]
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "onsetDateTime": "{{onsetDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'dd/MM/yyyy' | 'yyyy-MM-dd')}}",
          "clinicalStatus": {
            "coding": [
              {
                "code": "active",
                "system": "http://hl7.org/fhir/ValueSet/condition-clinical",
                "display": "Active"
              }
            ]
          },
          "category": [
            {
              "{{#categoryVar}}": "{{iif(%referenceEncounter.exists(), true)}}",
              "{{?}}": {
                "coding": [
                  "{{utl:createFhirCoding('http://terminology.hl7.org/CodeSystem/condition-category', 'encounter-diagnosis', 'Encounter Diagnosis')}}"
                ]
              }
            }
          ]
        }
      }
    }
  ]
}