{
  "id": "lab-results-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/lab-results-mapping",
  "name": "lab-results-mapping",
  "title": "The lab results mapping for CITBM LabResults data",
  "isDraft": false,
  "source": [
    {
      "alias": "labResults",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/LabResults",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {
    "unitConversionMap": {
      "category": "unit-conversion",
      "url": "$CONTEXT_REPO/citbm/lab-result-unit-conversion.csv"
    }
  },
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDate('yyyy-MM-dd').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDate('yyyy-MM-dd').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "The sodium",
      "precondition": {
        "name": "sodiumExists",
        "language": "text/fhirpath",
        "expression": "Sodium.exists()"
      },
      "expression": {
        "name": "sodium",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', identifier & 'LabResult-Sodium')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-LabResult"
            ]
          },
          "resourceType": "Observation",
          "status": "final",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "laboratory",
                  "display": "Laboratory"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "2951-2",
                "display": "Sodium",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{effectiveDateTime.utl:toFhirDate('yyyy-MM-dd')}}",
          "valueQuantity": "{{mpp:convertAndReturnQuantity(%unitConversionMap, 'Sodium', Sodium.toDecimal(), Unit_Sodium)}}",
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}"
        }
      }
    },
    {
