{
  "id": "catheterization-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/catheterization-mapping",
  "name": "catheterization-mapping",
  "title": "Catheterization",
  "isDraft": false,
  "source": [
    {
      "alias": "catheterization",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Catheterization",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "expression": {
        "name": "catheterization",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{identifier}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-RightHeartCatheterization"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "procedure",
                  "display": "Procedure"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "78930-5",
                "display": "Right heart catheterization performed",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "component": [
            {
              "{{#componentVar}}": "{{iif(Cardiac_Index_Lminm2.hasValue(), true, {})}}",
              "{{?}}": {
                "code": {
                  "coding": [
                    {
                      "system": "https://datatools4heart.eu/fhir/CodeSystem/rhc-parameter",
                      "code": "COi",
                      "display": "Cardiac output index (COi)"
                    }
                  ]
                },
                "valueQuantity": {
                  "value": "{{Cardiac_Index_Lminm2}}",
                  "unit": "L/min/m²"
                }
              },
              "@sliceName": "rhcParameter"
            },
            {
              "{{#componentVar}}": "{{iif(PCWP_mean_mmHg.hasValue(), true, {})}}",
              "{{?}}": {
                "code": {
                  "coding": [
                    {
                      "system": "http://loinc.org",
                      "code": "75994-4",
                      "display": "Pulmonary artery wedge pressure (PCWP)"
                    }
                  ]
                },
                "valueQuantity": {
                  "value": "{{PCWP_mean_mmHg}}",
                  "unit": "mmHg"
                }
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8414-5",
                    "display": "Pulmonary artery Mean blood pressure (mPAP)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{PA_mean_mmHg}}",
                "unit": "mmHg"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8385-7",
                    "display": "Pulmonary artery Diastolic blood pressure (PADP)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{PA_diastolic_mmHg}}",
                "unit": "mmHg"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8440-0",
                    "display": "Pulmonary artery Systolic blood pressure (PASP)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{PA_systolic_mmHg}}",
                "unit": "mmHg"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "60996-6",
                    "display": "Right atrial pressure (RAP)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{RA_mean_mmHg}}",
                "unit": "mmHg"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8741-1",
                    "display": "Cardiac output (CO)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{Cardiac_Output_Lmin}}",
                "unit": "L/min"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8831-0",
                    "display": "Systemic vascular resistance (SVR)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{Systemic_Vascular_Resistance_WoodUnits * 80}}",
                "unit": "dyn·sec/cm5"
              }
            },
            {
              "code": {
                "coding": [
                  {
                    "system": "http://loinc.org",
                    "code": "8828-6",
                    "display": "Pulmonary vascular resistance (PVR)"
                  }
                ]
              },
              "valueQuantity": {
                "value": "{{Pulmonary_Vascular_Resistance_WoodUnits * 80}}",
                "unit": "dyn·sec/cm5"
              }
            },
            {
              "{{#componentVar}}": "{{iif(RV_systolic_mmHg.exists(),true)}}",
              "{{?}}": {
                "code": {
                  "coding": [
                    {
                      "system": "http://loinc.org",
                      "code": "8432-7",
                      "display": "Right ventricular Intrachamber systolic pressure"
                    }
                  ]
                },
                "valueQuantity": {
                  "value": "{{RV_systolic_mmHg}}",
                  "unit": "mmHg"
                }
              }
            },
            {
              "{{#componentVar}}": "{{iif(RV_diastolic_mmHg.exists(),true)}}",
              "{{?}}": {
                "code": {
                  "coding": [
                    {
                      "system": "http://loinc.org",
                      "code": "8377-4",
                      "display": "Right ventricular Intrachamber diastolic pressure"
                    }
                  ]
                },
                "valueQuantity": {
                  "value": "{{RV_diastolic_mmHg}}",
                  "unit": "mmHg"
                }
              }
            }
          ],
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    }
  ]
}