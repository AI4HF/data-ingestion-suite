{
  "id": "vital-sign-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/vital-sign-mapping",
  "name": "vital-sign-mapping",
  "title": "The Vital Sign Mapping",
  "isDraft": false,
  "source": [
    {
      "alias": "vitalSigns",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/VitalSigns",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "The weight of patient.",
      "precondition": {
        "name": "weightExists",
        "language": "text/fhirpath",
        "expression": "Weight_29463_7.hasValue() and Weight_29463_7 != 0"
      },
      "expression": {
        "name": "weight",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'Weight')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "29463-7",
                "display": "Weight",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "system": "http://unitsofmeasure.org",
            "code": "kg",
            "value": "{{Weight_29463_7}}",
            "unit": "Kilogram"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    },
    {
      "description": "The height of the patient.",
      "precondition": {
        "name": "heightExists",
        "language": "text/fhirpath",
        "expression": "Height_8302_2.hasValue() and Height_8302_2 != 0"
      },
      "expression": {
        "name": "height",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'Height')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8302-2",
                "display": "Height",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "system": "http://unitsofmeasure.org",
            "code": "cm",
            "value": "{{Height_8302_2.toDecimal()}}",
            "unit": "Centimeter"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    },
    {
      "description": "The BMI of the patient.",
      "precondition": {
        "name": "heightAndWeightExists",
        "language": "text/fhirpath",
        "expression": "Height_8302_2.hasValue() and Height_8302_2 != 0 and Weight_29463_7.hasValue() and Weight_29463_7 != 0"
      },
      "expression": {
        "name": "bmi",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'BMI')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "39156-5",
                "display": "BMI",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "system": "http://unitsofmeasure.org",
            "code": "kg/m2",
            "value": "{{Weight_29463_7.toDecimal() / (Height_8302_2.toDecimal() * Height_8302_2.toDecimal())}}",
            "unit": "kg/m2"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    },
    {
      "description": "The systolic blood pressure of the patient.",
      "precondition": {
        "name": "systolicBloodPressureExists",
        "language": "text/fhirpath",
        "expression": "SBP_8480_6.hasValue() and SBP_8480_6 != 0"
      },
      "expression": {
        "name": "systolicBloodPressure",
        "language": "application/fhir-template+json",
        "value": {
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8480-6",
                "display": "Systolic blood pressure",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "value": "{{SBP_8480_6}}",
            "unit": "millimeters of mercury",
            "system": "http://unitsofmeasure.org",
            "code": "mm[Hg]"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final",
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'Systolic Blood Pressure')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation"
        }
      }
    },
    {
      "description": "Diastolic blood pressure of the patient.",
      "precondition": {
        "name": "diastolicBloodPressureExists",
        "language": "text/fhirpath",
        "expression": "DBP_8462_4.hasValue() and DBP_8462_4 != 0"
      },
      "expression": {
        "name": "diastolicBloodPressure",
        "language": "application/fhir-template+json",
        "value": {
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8462-4",
                "display": "Diastolic blood pressure",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "value": "{{DBP_8462_4}}",
            "unit": "millimeters of mercury",
            "system": "http://unitsofmeasure.org",
            "code": "mm[Hg]"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final",
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'Diastolic Blood Pressure')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation"
        }
      }
    },
    {
      "description": "Body Surface Are of the patient.",
      "precondition": {
        "name": "bodySurfaceAreaExists",
        "language": "text/fhirpath",
        "expression": "BSA_8277_6.hasValue() and BSA_8277_6 != 0"
      },
      "expression": {
        "name": "bodySurfaceArea",
        "language": "application/fhir-template+json",
        "value": {
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "vital-signs",
                  "display": "Vital Signs"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "8277-6",
                "display": "BSA_8277_6",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{ effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd' | 'dd/MM/yyyy')}}",
          "valueQuantity": {
            "value": "{{BSA_8277_6}}",
            "unit": "square meter",
            "system": "http://unitsofmeasure.org",
            "code": "m2"
          },
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final",
          "id": "{{mpp:getHashedId('Observation', subject & effectiveDateTime & encounter.lower() & 'BSA')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-VitalSign"
            ]
          },
          "resourceType": "Observation"
        }
      }
    }
  ]
}