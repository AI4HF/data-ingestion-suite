{
  "id": "smoking-status-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/smoking-status-mapping",
  "name": "smoking-status-mapping",
  "title": "Smoking Status Mapping",
  "isDraft": false,
  "source": [
    {
      "alias": "medication",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/SmokingStatus",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {
    "smokingStatusContext": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/citbm/smoking-status.csv"
    }
  },
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd' | 'dd/MM/yyyy').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "The smoking status of patient.",
      "expression": {
        "name": "smokingStatus",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & encounter & 'Smoking Status')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-SmokingStatus"
            ]
          },
          "resourceType": "Observation",
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "effectivePeriod": {
            "start": "{{startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd' | 'dd/MM/yyyy')}}"
          },
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "social-history",
                  "display": "Social History"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "72166-2",
                "display": "Tobacco smoking status",
                "@sliceName": "loincCode"
              }
            ]
          },
          "valueCodeableConcept": {
            "coding": [
              {
                "system": "http://snomed.info/sct",
                "code": "{{mpp:getConcept(%smokingStatusContext, smoking_status, 'target_code')}}",
                "display": "{{mpp:getConcept(%smokingStatusContext, smoking_status, 'target_display')}}"
              }
            ]
          },
          "status": "final"
        }
      }
    }
  ]
}