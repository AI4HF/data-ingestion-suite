{
  "id": "symptom-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/symptom-mapping",
  "name": "symptom-mapping",
  "title": "The symptom mappings of CITBM Symptomdata",
  "isDraft": false,
  "source": [
    {
      "alias": "symptom",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Symptom",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "expression": {
        "name": "symptom",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & encounter.lower() & Code)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Symptom"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "{{ category }}",
                  "display": "{{ category }}"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://snomed.info/sct",
                "code": "{{Code}}",
                "display": "{{display_ENG}}",
                "@sliceName": "snomedCode"
              }
            ]
          },
          "effectiveDateTime": "{{effectiveDateTime.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd')}}",
          "valueBoolean": true,
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    }
  ]
}