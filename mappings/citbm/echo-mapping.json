{
  "id": "echo-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/echo-mapping",
  "name": "echo-mapping",
  "title": "The echocardiographs mappings of CITBM Echo data.",
  "isDraft": false,
  "source": [
    {
      "alias": "echo",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Echo",
      "joinOn": [
        "subject"
      ]
    },
    {
      "alias": "encounter",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": [
        "subject"
      ]
    }
  ],
  "context": {},
  "variable": [
    {
      "name": "referenceEncounter",
      "language": "text/fhirpath",
      "expression": "%encounter.where($this.startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() >= %context.effectiveDateTime.utl:toFhirDateTime('MM/dd/yyyy' | 'yyyy-MM-dd' | 'd.MM.yyyy' | 'yyyy-MM-dd HH:mm:ss').utl:dateOf() and $this.endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').utl:dateOf() <= %context.effectiveDateTime.utl:toFhirDateTime('MM/dd/yyyy' | 'yyyy-MM-dd' | 'd.MM.yyyy' | 'yyyy-MM-dd HH:mm:ss').utl:dateOf()).first()"
    }
  ],
  "mapping": [
    {
      "description": "The echocardiographs.",
      "precondition": {
        "name": "lvefExists",
        "language": "text/fhirpath",
        "expression": "LVEF.exists() and LVEF != 'normal'"
      },
      "expression": {
        "name": "echo",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Observation', subject & encounter & effectiveDateTime & 'echo')}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Echocardiograph"
            ]
          },
          "resourceType": "Observation",
          "category": [
            {
              "coding": [
                {
                  "system": "http://terminology.hl7.org/CodeSystem/observation-category",
                  "code": "imaging",
                  "display": "Imaging"
                }
              ]
            }
          ],
          "code": {
            "coding": [
              {
                "system": "http://loinc.org",
                "code": "34552-0",
                "display": "Cardiac 2D echo panel",
                "@sliceName": "loincCode"
              }
            ]
          },
          "effectiveDateTime": "{{effectiveDateTime.utl:toFhirDateTime('MM/dd/yyyy' | 'yyyy-MM-dd' | 'd.MM.yyyy' | 'yyyy-MM-dd HH:mm:ss')}}",
          "component": [
            {
              "code": "{{utl:createFhirCodeableConcept('http://loinc.org', '8806-2', 'Left ventricular Ejection fraction by 2D echo')}}",
              "valueQuantity": {
                "value": "{{LVEF.toDecimal()}}"
              },
              "@sliceName": "echoParameter"
            },
            {
              "{{#componentVar}}": "{{iif(E_A.exists(),true)}}",
              "{{?}}": {
                "code": "{{utl:createFhirCodeableConcept('http://loinc.org', '59129-7', 'Left ventricular E-wave/A-wave by US')}}",
                "valueQuantity": {
                  "value": "{{E_A.toDecimal()}}"
                }
              },
              "@sliceName": "echoParameter"
            },
            {
              "{{#componentVar}}": "{{iif(S_VD.exists(),true)}}",
              "{{?}}": {
                "code": "{{utl:createFhirCodeableConcept('http://loinc.org', '11712-7', 'Tricuspid valve Peak systolic flow velocity by US.doppler')}}",
                "valueQuantity": {
                  "value": "{{S_VD.toDecimal()}}"
                }
              },
              "@sliceName": "echoParameter"
            },
            {
              "{{#componentVar}}": "{{iif(FAC_VD.exists(),true)}}",
              "{{?}}": {
                "code": "{{utl:createFhirCodeableConcept('https://datatools4heart.eu/fhir/CodeSystem/echo-parameter', 'FAC', 'Fractional area change')}}",
                "valueQuantity": {
                  "value": "{{FAC_VD.toDecimal()}}"
                }
              },
              "@sliceName": "echoParameter"
            }
          ],
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "encounter": "{{? iif(%referenceEncounter.exists(),mpp:createFhirReferenceWithHashedId('Encounter', %referenceEncounter.subject & %referenceEncounter.identifier))}}",
          "status": "final"
        }
      }
    }
  ]
}