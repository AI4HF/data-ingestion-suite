{
  "id": "encounter-mapping",
  "url": "https://ai4hf.eu/fhir/mappings/citbm/encounter-mapping",
  "name": "encounter-mapping",
  "title": "Encounter Mapping",
  "isDraft": false,
  "source": [
    {
      "alias": "encounters",
      "url": "https://ai4hf.eu/fhir/schemas/citbm/Encounter",
      "joinOn": []
    }
  ],
  "context": {
    "serviceTypeConceptMap": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/citbm/encounter-service-type.csv"
    },
    "encounterClassConceptMap": {
      "category": "concept-map",
      "url": "$CONTEXT_REPO/citbm/encounter-class.csv"
    }
  },
  "variable": [
    {
      "name": "encounterClassConcept",
      "language": "text/fhirpath",
      "expression": "iif(admissionDestination.hasValue(), mpp:getConcept(%encounterClassConceptMap, admissionDestination), mpp:getConcept(%encounterClassConceptMap, 'CONSULTA EXTERNA'))"
    },
    {
      "name": "serviceTypeConcept",
      "language": "text/fhirpath",
      "expression": "mpp:getConcept(%serviceTypeConceptMap, adminSource)"
    }
  ],
  "mapping": [
    {
      "description": "The encounter of the patient.",
      "expression": {
        "name": "encounter",
        "language": "application/fhir-template+json",
        "value": {
          "id": "{{mpp:getHashedId('Encounter', subject & identifier)}}",
          "meta": {
            "profile": [
              "https://datatools4heart.eu/fhir/StructureDefinition/HFR-Encounter"
            ]
          },
          "resourceType": "Encounter",
          "class": [
            {
              "coding": [
                {
                  "system": "{{%encounterClassConcept.target_system}}",
                  "code": "{{%encounterClassConcept.target_code}}",
                  "display": "{{%encounterClassConcept.target_display}}"
                }
              ]
            }
          ],
          "subject": "{{mpp:createFhirReferenceWithHashedId('Patient', subject)}}",
          "actualPeriod": {
            "start": "{{? startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd')}}",
            "end": "{{? endDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd').nav:orElse(startDate.utl:toFhirDateTime('yyyy-MM-dd HH:mm:ss' | 'yyyy-MM-dd'))}}"
          },
          "serviceType": [
            {
              "{{#serviceTypeVar}}": "{{iif(%serviceTypeConcept.hasValue(), true, {})}}",
              "{{?}}": {
                "concept": {
                  "coding": [
                    {
                      "system": "http://snomed.info/sct",
                      "code": "{{%serviceTypeConcept.target_code}}",
                      "display": "{{%serviceTypeConcept.target_display}}"
                    }
                  ]
                }
              }
            }
          ],
          "status": "completed",
          "serviceProvider": {
            "{{#serviceProviderVar}}": "{{iif(admissionOrigin.hasValue(), true, {})}}",
            "{{?}}": "{{mpp:createFhirReferenceWithHashedId('Organization', admissionOrigin)}}"
          }
        }
      }
    }
  ]
}